{
  "name": "@linxin666/dsh-pet",
  "description": "Desktop pet companion for DeepSeek Harness with task-aware pixel models, interactions, affinity, and Web UI settings",
  "version": "0.1.17",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-output.mjs && tsc -b --force && tsdown && cd desktop && electron-vite build",
    "test": "vitest run && vitest run --config desktop/vitest.config.mts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p desktop/tsconfig.json --noEmit --pretty false",
    "postinstall": "install-electron --no",
    "prepare": "node scripts/clean-output.mjs && tsc -b --force && tsdown --config tsdown.prepare.config.ts && cd desktop && electron-vite build",
    "desktop:build": "cd desktop && electron-vite build",
    "desktop:dev": "cd desktop && electron-vite",
    "desktop:smoke": "node desktop/scripts/electron-smoke.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "desktop/out",
    "desktop/package.json",
    "desktop/resources"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "electron": "^43.4.0",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron-vite": "^5.0.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  }
}
